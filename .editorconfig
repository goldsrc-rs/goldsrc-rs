# EditorConfig is awesome: https://EditorConfig.org

# Top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file, UTF-8 charset
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# Rust source files
[*.rs]
indent_size = 4
max_line_length = 100

# Python tooling & automation scripts
[*.py]
indent_size = 4
max_line_length = 100

# Web, Config, and Manifest formats
[*.{json,toml,yaml,yml}]
indent_size = 2

# Markdown documentation
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# C / C++ Headers and Reference sources
[*.{c,cpp,h,hpp,inl}]
indent_size = 4

# Shell scripts & Batch files
[*.sh]
indent_size = 4
end_of_line = lf

[*.bat]
indent_size = 4
end_of_line = crlf
